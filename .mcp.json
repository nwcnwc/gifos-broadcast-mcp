{
  "mcpServers": {
    "gifos-broadcast": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "git+https://github.com/nwcnwc/gifos-broadcast-mcp.git#d3442f8b8e7c9a9421802cff62d7f2a4945f5544"
      ],
      "env": {
        "npm_config_ignore_scripts": "true",
        "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip",
        "GIFOS_URL": "https://gifos.app"
      }
    }
  }
}
