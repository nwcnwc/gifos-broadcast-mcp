{
  "mcpServers": {
    "gifos-broadcast": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "git+https://github.com/nwcnwc/gifos-broadcast-mcp.git#e6ab2fd438488729dd3af836dd4c1e35351a6ec1"
      ],
      "env": {
        "npm_config_ignore_scripts": "true",
        "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip",
        "GIFOS_URL": "https://gifos.app"
      }
    }
  }
}
