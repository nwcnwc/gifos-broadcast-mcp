{
  "mcpServers": {
    "gifos-broadcast": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "git+https://github.com/nwcnwc/gifos-broadcast-mcp.git#a772b9f96501624ce8d9073ccb4464ef94ae29b7"
      ],
      "env": {
        "npm_config_ignore_scripts": "true",
        "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip",
        "GIFOS_URL": "https://gifos.app"
      }
    }
  }
}
