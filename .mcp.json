{
  "mcpServers": {
    "gifos-broadcast": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "git+https://github.com/nwcnwc/gifos-broadcast-mcp.git#28710644a95ebcf0c1f40d4c45dc5b804ed54c47"
      ],
      "env": {
        "npm_config_ignore_scripts": "true",
        "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip",
        "GIFOS_URL": "https://gifos.app"
      }
    }
  }
}
