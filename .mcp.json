{
  "mcpServers": {
    "gifos-broadcast": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "git+https://github.com/nwcnwc/gifos-broadcast-mcp.git#eef9bbea6d32772ec2c2d3fbd6089a4bcc5d8cbe"
      ],
      "env": {
        "npm_config_ignore_scripts": "true",
        "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip",
        "GIFOS_URL": "https://gifos.app"
      }
    }
  }
}
