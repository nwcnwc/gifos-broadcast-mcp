{
  "mcpServers": {
    "gifos-broadcast": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "npm@11.6.2",
        "exec",
        "-y",
        "--",
        "github:nwcnwc/gifos-broadcast-mcp#2af97d7fbf610405af8c999ca381510a705a4ba5"
      ],
      "env": {
        "npm_config_ignore_scripts": "true",
        "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip",
        "GIFOS_URL": "https://gifos.app"
      }
    }
  }
}
